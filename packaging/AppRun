#!/bin/sh
# HCX AppImage launcher: runs the bundled Python code with the system's
# Python 3, PyGObject, GTK 4 and libadwaita (all present on Fedora GNOME).
HERE="$(dirname "$(readlink -f "$0")")"
APPCODE="$HERE/usr/share/hcx"

PY=""
for cand in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$cand" >/dev/null 2>&1 && "$cand" -s -c "import gi; gi.require_version('Gtk','4.0'); gi.require_version('Adw','1'); from gi.repository import Gtk, Adw; assert Adw.get_minor_version() >= 5" >/dev/null 2>&1; then
        PY="$cand"
        break
    fi
done

if [ -z "$PY" ]; then
    MSG="HCX precisa do Python 3 com GTK 4 e libadwaita 1.5 ou mais novo.
No Fedora: sudo dnf install python3-gobject gtk4 libadwaita
No Ubuntu/Debian: sudo apt install python3-gi gir1.2-gtk-4.0 gir1.2-adw-1"
    echo "$MSG" >&2
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title=HCX --text="$MSG" 2>/dev/null
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "HCX" "$MSG"
    fi
    exit 1
fi

export HCX_APPDIR="$HERE"
exec "$PY" -s -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from hcx.app import main; sys.exit(main(["hcx"] + sys.argv[1:]))' "$APPCODE" "$@"
