Comment[es]=Abre y recorre pilas de HyperCard del Macintosh clásico
Exec=hcx %F
Icon=io.github.pgostation.HCX
Terminal=false
Categories=Utility;
Keywords=HyperCard;Macintosh;stack;Mac;StuffIt;
MimeType=application/x-stuffit;application/mac-binhex40;application/x-macbinary;
StartupNotify=true
