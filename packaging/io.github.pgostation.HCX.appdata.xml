<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.pgostation.HCX</id>
  <name>HCX</name>
  <summary>HyperCard stack reader</summary>
  <summary xml:lang="pt_BR">Leitor de pilhas HyperCard</summary>
  <summary xml:lang="es">Lector de pilas de HyperCard</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>HCX opens classic Macintosh HyperCard stacks (also inside MacBinary, BinHex, AppleDouble files and HFS disk images) and lets you browse their cards, buttons and fields. Linux port of pgostation's HCX.</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/goliv04053/hcx-linux/main/docs/screenshots/find.png</image>
      <caption>A stack card with its navigation palette and search results</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/goliv04053/hcx-linux/main/docs/screenshots/inspector.png</image>
      <caption>The object inspector</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/goliv04053/hcx-linux/main/docs/screenshots/chapter-menu.png</image>
      <caption>A menu made by the stack's own HyperTalk scripts</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/goliv04053/hcx-linux/main/docs/screenshots/colors.png</image>
      <caption>A stack colored with AddColor</caption>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">io.github.pgostation.HCX.desktop</launchable>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="3.1" date="2026-11-21">
      <description>
        <p>AddColor colors, MACE and IMA compressed sounds, and many HyperTalk fixes found by testing 178 stacks. Scripts no longer freeze the window; Esc stops one.</p>
      </description>
    </release>
    <release version="3.0" date="2026-11-21">
      <description>
        <p>First release for Linux, with a HyperTalk interpreter and native versions of common XCMDs.</p>
      </description>
    </release>
  </releases>
</component>
